{
  "version": 2,
  "builds": [
    { "src": "api/mcp.ts", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/.well-known/(.*)", "dest": "/public/.well-known/$1" },
    { "src": "/api/(.*)", "dest": "/api/mcp.ts" }
  ],
  "regions": ["gru1"]
}